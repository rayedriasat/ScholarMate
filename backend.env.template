# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Pinecone (Vector Database)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=scholarmate
PINECONE_DIMENSION=384
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embedding Model (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HuggingFace Token (required to avoid rate limiting)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token

# Memory Optimization (CRITICAL for Render free tier 512MB limit)
# These settings control batch sizes during PDF indexing
# Smaller values = less memory usage but slower processing
# RECOMMENDED for Render free tier (512MB RAM):
EMBEDDING_BATCH_SIZE=3          # Chunks to embed at once (default: 3, max: 10)
PDF_PAGE_BATCH_SIZE=2           # PDF pages to process at once (default: 2, max: 5)
PINECONE_BATCH_SIZE=25          # Vectors to upsert to Pinecone at once (default: 25, max: 100)

# For local development with more RAM, you can increase these:
# EMBEDDING_BATCH_SIZE=10
# PDF_PAGE_BATCH_SIZE=5
# PINECONE_BATCH_SIZE=50

# AI Providers
OPENROUTER_API_KEY=your_openrouter_api_key
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_CHAT_MODEL=moonshotai/kimi-k2:free

# GROQ AI
GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_EMBEDDING_MODEL=llama-3.3-70b-versatile

# OCR Configuration
# Tesseract OCR is used for all OCR operations (no API key needed)
# Ensure Tesseract is installed on your system:
# - Windows: Download from https://github.com/UB-Mannheim/tesseract/wiki
# - Linux: apt-get install tesseract-ocr
# - macOS: brew install tesseract

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key

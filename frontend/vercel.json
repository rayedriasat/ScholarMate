{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "build/web/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/config.go",
      "use": "@vercel/go"
    }
  ],
  "routes": [
    {
      "src": "/api/config",
      "dest": "/api/config.go"
    },
    {
      "src": "/(.*)",
      "dest": "/build/web/$1"
    }
  ]
}

# Vercel ignore file - exclude unnecessary files from deployment
# Note: We're deploying prebuilt files from frontend/build/web

# Backend (not needed for frontend deployment)
backend/
*.env
backend.env.template
frontend.env.template

# Source code (not needed, using prebuilt files)
frontend/lib/
frontend/test/
frontend/android/
frontend/ios/
frontend/linux/
frontend/macos/
frontend/windows/
frontend/web/

# Flutter/Dart development files
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/pubspec.yaml
frontend/pubspec.lock
frontend/analysis_options.yaml

# Build artifacts (except web)
frontend/build/android/
frontend/build/ios/
frontend/build/linux/
frontend/build/macos/
frontend/build/windows/

# IDE
.vscode/
.idea/
*.iml

# Git
.git/

# Documentation (optional - remove if you want to include)
*.md
!README.md

# Test files
**/*_test.dart

# Misc
.DS_Store
*.log
.kiro/

{
  "buildCommand": null,
  "outputDirectory": "frontend/build/web",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
